{
  "name": "eskiz-test",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal Eskiz.uz client — send SMS and manage templates",
  "type": "commonjs",
  "scripts": {
    "send": "node --import tsx send.ts",
    "templates": "node --import tsx templates-list.ts",
    "templates:list": "node --import tsx templates-list.ts",
    "templates:create": "node --import tsx templates-create.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
