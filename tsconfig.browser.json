{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleDetection": "legacy",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "rootDir": "browser",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["browser/**/*.ts"]
}
