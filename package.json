{
  "name": "scrapregosuserbot",
  "version": "1.0.0",
  "description": "",
  "main": "apps/bot/index.js",
  "scripts": {
    "fetch": "tsx cli/fetch-partners.ts",
    "login": "tsx cli/fetch-partners-interactive.ts",
    "fetch:auth": "set HEADLESS=1&& tsx cli/fetch-partners-interactive.ts",
    "login:sessions": "tsx cli/login-sessions.ts",
    "import:json": "tsx cli/import-partners-json.ts",
    "sync": "tsx cli/sync-partners.ts",
    "import:accounts-json": "tsx cli/import-partner-accounts-json.ts",
    "sync:accounts": "tsx cli/sync-partner-accounts.ts",
    "login:easytrade": "tsx cli/login-easytrade.ts",
    "import:licenses-json": "tsx cli/import-licenses-json.ts",
    "sync:licenses": "tsx cli/sync-licenses.ts",
    "sync:all": "tsx cli/sync-all.ts",
    "sync:rpos": "tsx cli/sync-rpos.ts",
    "sync:vcr1": "tsx cli/sync-vcr1.ts",
    "bot": "node apps/bot/index.js",
    "build:browser": "node scripts/check-browser.cjs --emit",
    "server": "npm run build:browser && node apps/server/index.js",
    "telegram:login": "tsx cli/telegram-mtproto-login.ts",
    "telegram:send": "tsx cli/telegram-mtproto-send.ts",
    "service:install": "tsx scripts/install-bot-service.ts",
    "service:uninstall": "tsx scripts/uninstall-bot-service.ts",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "task:install": "powershell -ExecutionPolicy Bypass -File scripts/install-sync-task.ps1",
    "task:uninstall": "powershell -ExecutionPolicy Bypass -File scripts/uninstall-sync-task.ps1",
    "test": "npm run build:browser && node --import tsx --test test/**/*.test.ts",
    "bot-admin-ui:dev": "npm run dev --prefix bot-admin-ui",
    "bot-admin-ui:build": "npm run build --prefix bot-admin-ui"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "ioredis": "^5.11.1",
    "multer": "^2.2.0",
    "music-metadata": "^11.14.0",
    "node-telegram-bot-api": "^0.67.0",
    "node-windows": "^1.0.0-beta.8",
    "openai": "^4.104.0",
    "playwright": "^1.60.0",
    "telegram": "^2.26.22",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/node-telegram-bot-api": "^0.64.15",
    "@types/ws": "^8.18.2"
  }
}
