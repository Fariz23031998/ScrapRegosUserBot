{
  "name": "scrapregosuserbot",
  "version": "1.0.0",
  "description": "",
  "main": "apps/bot/index.js",
  "scripts": {
    "fetch": "node cli/fetch-partners.js",
    "login": "node cli/fetch-partners-interactive.js",
    "fetch:auth": "set HEADLESS=1&& node cli/fetch-partners-interactive.js",
    "login:sessions": "node cli/login-sessions.js",
    "import:json": "node cli/import-partners-json.js",
    "sync": "node cli/sync-partners.js",
    "import:accounts-json": "node cli/import-partner-accounts-json.js",
    "sync:accounts": "node cli/sync-partner-accounts.js",
    "login:easytrade": "node cli/login-easytrade.js",
    "import:licenses-json": "node cli/import-licenses-json.js",
    "sync:licenses": "node cli/sync-licenses.js",
    "sync:all": "node cli/sync-all.js",
    "sync:rpos": "node cli/sync-rpos.js",
    "sync:vcr1": "node cli/sync-vcr1.js",
    "bot": "node apps/bot/index.js",
    "server": "node apps/server/index.js",
    "telegram:login": "node cli/telegram-mtproto-login.js",
    "telegram:send": "node cli/telegram-mtproto-send.js",
    "service:install": "node scripts/install-bot-service.js",
    "service:uninstall": "node scripts/uninstall-bot-service.js",
    "task:install": "powershell -ExecutionPolicy Bypass -File scripts/install-sync-task.ps1",
    "task:uninstall": "powershell -ExecutionPolicy Bypass -File scripts/uninstall-sync-task.ps1",
    "test": "node --test test/**/*.test.js",
    "bot-admin-ui:dev": "npm run dev --prefix bot-admin-ui",
    "bot-admin-ui:build": "npm run build --prefix bot-admin-ui"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "ioredis": "^5.11.1",
    "music-metadata": "^11.14.0",
    "node-telegram-bot-api": "^0.67.0",
    "node-windows": "^1.0.0-beta.8",
    "openai": "^4.104.0",
    "playwright": "^1.60.0",
    "telegram": "^2.26.22",
    "ws": "^8.21.0"
  }
}
