# Dedicated host: Telegram webhooks + ScrapRegosUserBot payment server
# TELEGRAM_WEBHOOK_BASE_URL=https://aserver.tech
# ScrapRegosUserBot .env: PUBLIC_BASE_URL=https://aserver.tech
# CLICK merchant URLs: https://aserver.tech/click/prepare and /click/complete
server {
    server_name aserver.tech www.aserver.tech;

    client_max_body_size 50M;

    # Regos Partner Bot — legacy Telegram webhook
    location /webhook {
        proxy_pass http://127.0.0.1:8001/webhook;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_connect_timeout 75s;
    }

    # Regos Wholesale backend — Telegram webhook
    location /api/v1/telegram/webhook/ {
        proxy_pass http://127.0.0.1:8005;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_connect_timeout 75s;
    }

    # ScrapRegosUserBot — payment / prices / admin server (port 3000, npm run server)
    # Bot admin React SPA is served by nginx from bot-admin-ui/dist (npm run bot-admin-ui:build).
    # Only /bot-admin/api, /auth, /rights-meta, and /mcp are proxied to Node.

    location /api/orders/ {
        proxy_pass http://127.0.0.1:3000/api/orders/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Public service prices catalog (GET /api/prices)
    location = /api/prices {
        proxy_pass http://127.0.0.1:3000/api/prices;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # REGOS CRM ticket webhooks
    location = /api/regos/webhook {
        proxy_pass http://127.0.0.1:3000/api/regos/webhook;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /click/ {
        proxy_pass http://127.0.0.1:3000/click/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /bot-admin {
        return 301 /bot-admin/;
    }

    # Keep the ticket event stream unbuffered and open.
    location = /bot-admin/api/tickets/events {
        proxy_pass http://127.0.0.1:3000/bot-admin/api/tickets/events;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location /bot-admin/api/ {
        proxy_pass http://127.0.0.1:3000/bot-admin/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /bot-admin/auth/ {
        proxy_pass http://127.0.0.1:3000/bot-admin/auth/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /bot-admin/rights-meta {
        proxy_pass http://127.0.0.1:3000/bot-admin/rights-meta;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /bot-admin/mcp {
        proxy_pass http://127.0.0.1:3000/bot-admin/mcp;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Vite hashed assets (filenames change per build — safe to cache 1y).
    location ^~ /bot-admin/assets/ {
        alias /srv/ScrapRegosUserBot/bot-admin-ui/dist/assets/;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        access_log off;
    }

    # React SPA shell + other files from dist (deep links fall back to index.html).
    # Prefer error_page over try_files here — alias + try_files is unreliable in nginx.
    # no-cache: revalidate HTML every navigation; a new index.html points at new hashed assets.
    location /bot-admin/ {
        alias /srv/ScrapRegosUserBot/bot-admin-ui/dist/;
        index index.html;
        error_page 404 = @bot_admin_spa;
        expires -1;
        add_header Cache-Control "no-cache, must-revalidate" always;
    }

    location @bot_admin_spa {
        rewrite ^ /bot-admin/index.html last;
    }

    location = /bot-admin/index.html {
        alias /srv/ScrapRegosUserBot/bot-admin-ui/dist/index.html;
        expires -1;
        add_header Cache-Control "no-cache, must-revalidate" always;
    }

    location = /pay {
        proxy_pass http://127.0.0.1:3000/pay;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    # Public prices page (bot /prices command → https://aserver.tech/prices)
    location = /prices {
        proxy_pass http://127.0.0.1:3000/prices;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    location = /health {
        proxy_pass http://127.0.0.1:3000/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /brand-logo.png {
        proxy_pass http://127.0.0.1:3000/brand-logo.png;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
        expires 7d;
        add_header Cache-Control "public, max-age=604800" always;
    }

    # Static assets: payment + prices pages (and future public CSS/JS).
    # Cache CSS/JS/images in browsers; HTML shells stay uncached via other locations.
    location /css/ {
        proxy_pass http://127.0.0.1:3000/css/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
        expires 7d;
        add_header Cache-Control "public, max-age=604800" always;
    }

    location /js/ {
        proxy_pass http://127.0.0.1:3000/js/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
        expires 7d;
        add_header Cache-Control "public, max-age=604800" always;
    }

    location /images/ {
        proxy_pass http://127.0.0.1:3000/images/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
        expires 7d;
        add_header Cache-Control "public, max-age=604800" always;
    }

    # Payment page: https://aserver.tech/{order-uuid}
    location ~ "^/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    location /sms-gateway/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/aserver.tech/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/aserver.tech/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}
server {
    if ($host = www.aserver.tech) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = aserver.tech) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name aserver.tech www.aserver.tech;
    return 404; # managed by Certbot
}
