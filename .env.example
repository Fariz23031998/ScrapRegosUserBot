TELEGRAM_BOT_TOKEN=your_bot_token_here

BUKHARA_REGOS_AUTH_PHONE=+998000000001
BUKHARA_REGOS_AUTH_PASSWORD=your_bukhara_password

SAMARKAND_REGOS_AUTH_PHONE=+998000000002
SAMARKAND_REGOS_AUTH_PASSWORD=your_samarkand_password

# Chayxanshik RPOS (Django admin) — optional per account
# SAMARKAND_RPOS_USERNAME=timur
# SAMARKAND_RPOS_PASSWORD=your_rpos_password
# BUKHARA_RPOS_USERNAME=
# BUKHARA_RPOS_PASSWORD=

# Bot admin panel (/bot-admin/) — manage employees and rights
# Env login/password is the unrestricted superuser fallback.
# Per-employee logins can be set in Users tab (stored hashed in DB).
# Employees with the open_admin_dashboard right can also open the panel via
# /open_dashboard in Telegram (one-time link, ~5 minutes, uses PUBLIC_BASE_URL).
BOT_ADMIN_LOGIN=admin
BOT_ADMIN_PASSWORD=change_me

# Regos CRM Integration API (Ticket/Get for /bot-admin/tickets)
# Token stays server-side; never expose to the browser.
REGOS_INTEGRATION_TOKEN=
# REGOS_BEARER_TOKEN=
# REGOS_API_TARGET=https://integration.regos.uz
# Comma-separated recording hosts the HTTPS admin may proxy (SSRF allowlist).
# REGOS_RECORDING_ALLOWED_HOSTS=rofeev.7x.uz

# CLICK payment integration (optional — leave blank to run on Payme only)
# Set ENABLE_CLICK_PAYMENT=1 *and* fill all four keys below to activate CLICK.
CLICK_MERCHANT_ID=your_click_merchant_id
CLICK_SERVICE_ID=your_click_service_id
CLICK_MERCHANT_USER_ID=your_click_merchant_user_id
CLICK_SECRET_KEY=your_click_secret_key
CLICK_RETURN_URL=https://aserver.tech/example-order-id
CLICK_SERVER_PORT=3000
PUBLIC_BASE_URL=https://aserver.tech

# Payme Subscribe API (receipts — no webhook required)
PAYME_MERCHANT_ID=your_merchant_id_from_cabinet
PAYME_SECRET_KEY=your_key_from_cabinet
PAYME_TEST_KEY=your_sandbox_test_key
PAYME_TEST_MODE=0
# Optional receipt freshness window (default 12h)
# PAYME_RECEIPT_TTL_MS=43200000
# Set to 1 to enable CLICK (button on payment page, /click/* webhooks).
# When 0 or when CLICK keys are blank, orders are created with the payme provider.
ENABLE_CLICK_PAYMENT=0

# Android SMS gateway (Redis queue + WebSocket app)
REDIS_URL=redis://127.0.0.1:6379
SMS_GATEWAY_TOKEN=change_me_long_random_secret
# Set to 0 to disable SMS enqueue + WebSocket gateway (default: enabled when unset)
SMS_GATEWAY_ENABLED=1
TELEGRAM_BOT_USERNAME=@MyShopBot

# Telegram MTProto user-account notifier (send by phone; independent of Bot API)
# Get api_id/api_hash at https://my.telegram.org then run: npm run telegram:login
ENABLE_TELEGRAM_MTPROTO=0
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_MTPROTO_SESSION=

# GETSMS.UZ HTTP transport (independent from Android; both may be enabled)
ENABLE_GETSMS=0
GETSMS_LOGIN=
GETSMS_PASSWORD=
# GETSMS_NICKNAME=ROFEEV
# GETSMS_URL=http://185.8.212.184/smsgateway/
SMS_SUPPORT_TELEGRAM_URL=https://t.me/EasyTradesupport_bot
SMS_WEBSITE_URL=https://rofeev.uz
SMS_SUPPORT_PHONE=+998 55 705-00-30
# Shared multiline template for GETSMS HTTP and Android WebSocket (one SMS per order):
# GETSMS_MESSAGE_TEMPLATE="Оплата услуг ROFEEV TECHNOLOGY
# Ссылка на оплату создана на сумму {amount} {currency}.
# Оплатить: {payment_page_url}
# Служба поддержки (Telegram): {support_telegram_url}
# Веб-сайт: {website_url}
# Телефон: {support_phone}"
